# ===== Docker Compose 环境变量模板 =====
# docker-compose 会自动读取**项目根目录**下的 .env 文件（不是 backend/.env）。
#
# 使用方式：
#   cp .env.example .env
#   然后用编辑器填入下面各项的真实值
#
# 注意：.env 已被 .gitignore 忽略，不会被提交到仓库。

# ⚠️ 必填 —— JWT 签名密钥。
# 留空会导致 docker-compose 直接报错退出（这是有意设计的 fail-closed 行为：
# 宁可起不来，也不要带着一个可被猜到的密钥上线）。
# 生成方式：
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ⚠️ 必填 —— MySQL root 密码
DB_PASSWORD=

# MySQL 数据库名
DB_NAME=legal_doc_db

# 允许调用 POST /api/knowledge/reload（重建知识库）的用户名，逗号分隔。
# 留空表示只要求登录、不限制具体是谁。例：ADMIN_USERNAMES=alice,bob
ADMIN_USERNAMES=

# 限流开关
RATE_LIMIT_ENABLED=true

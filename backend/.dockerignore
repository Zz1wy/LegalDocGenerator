# 虚拟环境（容器里不需要，会自己建）
venv/
.venv/
env/

# Python 缓存
__pycache__/
*.pyc
*.pyo

# 敏感文件（用 docker-compose 的环境变量注入）
# 排除所有 .env 变体；镜像内不需要示例模板。
.env*

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp

# 运行期生成的向量索引：必须在容器启动时重建，不能把宿主机缓存打进镜像
# （镜像里带旧元数据会让启动逻辑误判「知识库已是最新」，而数据卷实际为空）
rag/chroma_db/
rag/index_meta.json

# 测试
tests/
test_*.py

# 文档（排除根目录的 md，保留 rag/legal_data/ 中的法律数据）
/README.md
/*.md

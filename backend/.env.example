# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=legal_doc_db

# ==================== JWT 配置 ====================
# 请使用 openssl rand -hex 32 生成随机密钥
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# ==================== Ollama 配置 ====================
OLLAMA_HOST=http://localhost:11434

# ==================== 应用配置 ====================
DEBUG=false

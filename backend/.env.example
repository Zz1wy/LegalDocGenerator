# ==================== 数据库配置 ====================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=legal_doc_db

# ==================== JWT 配置 ====================
# ⚠️ 必填，且不能保留下面的示例值。
# 应用启动时会检查：如果 SECRET_KEY 为空或仍是示例值，直接拒绝启动。
# 生成方式（任选其一）：
#   python -c "import secrets; print(secrets.token_hex(32))"
#   openssl rand -hex 32
# 原因：HS256 算法是公开的，JWT 的安全性完全依赖这个密钥的保密性。
# 密钥一旦可被猜到，任何人都能离线伪造出任意用户（比如 user_id=1）的合法令牌。
SECRET_KEY=change-me-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# ==================== 运维接口白名单 ====================
# 允许调用 POST /api/knowledge/reload（重建整个知识库）的用户名，逗号分隔。
# 留空则只要求登录，不限制具体是谁 —— 本地开发够用，线上建议显式配置。
# 例：ADMIN_USERNAMES=alice,bob
ADMIN_USERNAMES=

# ==================== Ollama 配置 ====================
OLLAMA_HOST=http://localhost:11434

# ==================== 限流 ====================
# 设为 false 可整体关闭限流。仅建议在自动化测试中关闭。
# 规则本身在 main.py 的 RATE_LIMIT_RULES 里配置。
RATE_LIMIT_ENABLED=true

# ==================== 应用配置 ====================
DEBUG=false
